# Copy to backend/.env and fill in. Never commit real keys.

# Keys only. Which model does each job, and in what fallback order, is in config/models.json;
# override it on this machine in config/models.local.json. Put machine-only keys in .env.local (gitignored).
# Check every configured model with its key: uv run python scripts/smoke.py

# Gemini (reads messy rows, splits awkward names, writes the analyst and meeting-prep text)
GEMINI_API_KEY=

# Claude (Anthropic) and OpenAI: optional. Either can do any job Gemini does (reading, web search, writing);
# add their models to a job's chain on the setup screen (Models button) or in config/models.local.json.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Jev by TypeSafe (small typed judgments: location matches, project type, semantic checks, watchdog)
# JEV_PROVIDER = where Jev runs: typesafe | openrouter | cloudflare | mock (local heuristics, labeled "Jev (mock)") | empty = off
JEV_PROVIDER=typesafe
TYPESAFE_API_KEY=
# OPENROUTER_API_KEY=
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=

# Tiger Data (managed Postgres + TimescaleDB). Empty = files only.
# Use the service URL from the Tiger console, e.g. postgres://tsdbadmin:PASSWORD@HOST:PORT/tsdb?sslmode=require
DATABASE_URL=

# OpenStreetMap
NOMINATIM_USER_AGENT=tandem-shellhacks/0.1 (contact: your-team-email)
# Research team: also run a Google-grounded Gemini search each live run (needs Gemini quota). Off = research file only.
RESEARCH_LIVE=false
NOMINATIM_BUDGET_S=60              # live Nominatim time per run; the rest is looked up (and cached) next run

# Demo pacing: 1.0 = watchable (~20 s run), 0 = instant
TANDEM_PACE=1.0
# Fixed "today" so past-date checks are reproducible
TANDEM_TODAY=2026-09-26

# Cost bonus: a savings figure is shown only when BOTH are set (share of construction cost avoided by one
# shared mobilization, and the published source you took it from)
COST_MOBILIZATION_SHARE=
COST_SOURCE=

# Model setup screen (Models button). local: keys can be pasted there and are saved to backend/.env.local.
# hosted: keys only from the server's environment, and the setup screen needs ADMIN_PASSCODE (checked on the server).
APP_MODE=local
ADMIN_PASSCODE=

# Browser origins allowed to call the API (local dev frontend)
CORS_ORIGINS=http://localhost:3000
