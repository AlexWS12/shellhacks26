# Copy to backend/.env and fill in. Never commit real keys.

# Gemini (reads messy rows, splits awkward names, writes the analyst and meeting-prep text)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash      # check the current list at ai.google.dev/gemini-api/docs/models

# Jev by TypeSafe (small typed judgments: location matches, project type, semantic checks, watchdog)
# JEV_PROVIDER = typesafe | openrouter | cloudflare | mock (local heuristics, labeled "Jev (mock)") | empty = off
JEV_PROVIDER=typesafe
TYPESAFE_API_KEY=
# OPENROUTER_API_KEY=
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
# JEV_MODEL=                        # default jev-latest (typesafe), typesafe/jev-latest (openrouter), typesafe/jev (cloudflare)

# Tiger Data (managed Postgres + TimescaleDB). Empty = files only.
# Use the service URL from the Tiger console, e.g. postgres://tsdbadmin:PASSWORD@HOST:PORT/tsdb?sslmode=require
DATABASE_URL=

# OpenStreetMap
NOMINATIM_USER_AGENT=tandem-shellhacks/0.1 (contact: your-team-email)

# Demo pacing: 1.0 = watchable (~20 s run), 0 = instant
TANDEM_PACE=1.0
# Fixed "today" so past-date checks are reproducible
TANDEM_TODAY=2026-09-26

# Cost bonus: a savings figure is shown only when BOTH are set (share of construction cost avoided by one
# shared mobilization, and the published source you took it from)
COST_MOBILIZATION_SHARE=
COST_SOURCE=

# Browser origins allowed to call the API (local dev frontend)
CORS_ORIGINS=http://localhost:3000
